package bank.view;

import bank.controller.LoginController;
import bank.controller.Session;
import bank.model.Bank;
import javafx.geometry.Insets;
import javafx.geometry.Pos;
import javafx.scene.Parent;
import javafx.scene.control.Button;
import javafx.scene.control.Hyperlink;
import javafx.scene.control.Label;
import javafx.scene.control.PasswordField;
import javafx.scene.control.TextField;
import javafx.scene.layout.StackPane;
import javafx.scene.layout.VBox;

/** Boundary class: collects credentials and shows the result. All checks happen in LoginController. */
public class LoginView {

    private final LoginController controller;
    private final Navigator navigator;

    public LoginView(LoginController controller, Navigator navigator) {
        this.controller = controller;
        this.navigator = navigator;
    }

    public Parent getRoot() {
        TextField username = new TextField();
        username.setPromptText("Username");
        PasswordField password = new PasswordField();
        password.setPromptText("Password");

        Button login = new Button("Log in");
        Ui.primary(login);
        login.setDefaultButton(true);
        login.setMaxWidth(Double.MAX_VALUE);
        login.setOnAction(e -> Ui.guard(() -> {
            Session session = controller.login(username.getText(), password.getText());
            navigator.showHome(session);
        }));

        Hyperlink register = new Hyperlink("New customer? Register here");
        register.setOnAction(e -> navigator.showRegister());

        VBox card = Ui.card(360);
        card.getChildren().addAll(Ui.title(Bank.NAME), Ui.hint("Please log in to continue."),
                new Label("Username"), username, new Label("Password"), password, login, register);

        StackPane root = new StackPane(card);
        root.setPadding(new Insets(30));
        root.setAlignment(Pos.CENTER);
        root.setStyle("-fx-background-color: #e8eef5;");
        return root;
    }
}

